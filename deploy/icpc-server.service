# ICPC Remote Control server (admin UI + client TCP + mDNS).
# sudo cp bin/server /opt/icpc/icpc-server
# sudo cp deploy/icpc-server.service /etc/systemd/system/
# sudo systemctl daemon-reload && sudo systemctl enable --now icpc-server

[Unit]
Description=ICPC Remote Control Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/icpc
ExecStart=/opt/icpc/icpc-server --port 8080 --tcp-port 8081 --db /opt/icpc/icpc.db
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
